# Qloo hackathon key. Works only on https://hackathon.api.qloo.com
QLOO_API_KEY=
QLOO_BASE_URL=https://hackathon.api.qloo.com

# Neon Postgres (filled in by the Vercel Marketplace integration; `vercel env pull` brings it down)
DATABASE_URL=

# Vercel AI Gateway. On Vercel, OIDC handles auth; locally use `vercel env pull` or set a key
AI_GATEWAY_API_KEY=
