# Qloo hackathon key. Works only on https://hackathon.api.qloo.com
QLOO_API_KEY=
QLOO_BASE_URL=https://hackathon.api.qloo.com

# Neon Postgres (filled in by the Vercel Marketplace integration; `vercel env pull` brings it down)
DATABASE_URL=

# Gemini on Vertex AI: the project, its region ("global" works) and a service account key as base64
GOOGLE_VERTEX_PROJECT=
GOOGLE_VERTEX_LOCATION=global
GOOGLE_VERTEX_CREDENTIALS_B64=

# Cron routes check this as a bearer token
CRON_SECRET=

# The operator key for /admin (24+ characters)
ADMIN_KEY=

# Mail (optional). Nothing real goes out unless MAIL_LIVE=1
ZOHO_MAIL_USER=
ZOHO_APP_PASSWORD=
ZOHO_SMTP_HOST=
ZOHO_IMAP_HOST=
MAIL_LIVE=
HANDOFF_EMAIL=
SYZYGY_POSTAL_ADDRESS=

# Letters through PostGrid (optional). Test key unless POSTGRID_LIVE=1
POSTGRID_API_KEY=
POSTGRID_LIVE_KEY=
POSTGRID_LIVE=

# CRM connectors (optional)
HUBSPOT_CLIENT_ID=
HUBSPOT_CLIENT_SECRET=
SALESFORCE_CLIENT_ID=
SALESFORCE_CLIENT_SECRET=
CRM_TOKEN_KEY=
